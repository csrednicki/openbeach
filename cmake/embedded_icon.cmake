# Files built into the program as byte arrays in generated headers. Generated at configure time; a newer file regenerates its
# header.
#
# obl_embedded_bytes(target file name header): `file` (relative to the repository) as `inline constexpr unsigned char name[]` in
# `header`, in the target's include path.
function(obl_embedded_bytes target file name header)
    set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../${file}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/${header}")
    file(SIZE "${source}" size)
    if(NOT EXISTS "${output}" OR "${source}" IS_NEWER_THAN "${output}")
        file(READ "${source}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        file(WRITE "${output}" "// Generated by cmake/embedded_icon.cmake from ${file}; do not edit.\n#pragma once\n\n"
            "inline constexpr unsigned char ${name}[${size}] = {\n${bytes}};\n")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction()

# The OpenBeach icon (assets/logo/openbeach.ico, tools/make_icons.py) in openbeach_icon.gen.h: the window icon on every system
# (src/platform/sdl_present.cpp).
function(obl_embedded_icon target)
    obl_embedded_bytes(${target} assets/logo/openbeach.ico kOpenBeachIcon openbeach_icon.gen.h)
endfunction()
